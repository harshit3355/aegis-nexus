{
  "version": "world-v1",
  "note": "SYNTHETIC. A simulated three-cloud agent deployment; every identity, key, weight and lifetime is invented for the benchmark.",
  "epoch": 1767225600,
  "user": "user:alice",
  "gateway": "https://gateway.aegis.sim",
  "policy_version": "pv-1",
  "env": "prod",
  "compromise_at_s": 60,
  "horizon_h": 2160,
  "ttl_s": {"static_key": 7776000, "svid": 3600, "exchange": 3600, "root": 3600, "user_session": 28800},
  "max_depth": 3,
  "parties": {
    "planner":    {"spiffe": "spiffe://aws.sim/agent/planner",        "parent": null,
