    {"id": "S22", "family": "wrong environment", "title": "staging planner + coder tokens replayed against prod tools", "steal": ["planner", "coder"], "env": "staging"},
    {"id": "S23", "family": "issuer compromise", "title": "gcp.sim trust-domain signing key stolen", "issuer": "gcp.sim"},
    {"id": "S24", "family": "issuer compromise", "title": "delegation gateway / authorization server signing key stolen", "gateway_key": true},
    {"id": "S25", "family": "forgery", "title": "outsider self-signs tokens claiming to be the planner", "outsider": true},
    {"id": "S26", "family": "negative case", "title": "root workload (planner) compromised while its credential is valid, detected after 4 h", "compromise": "planner", "detect_after_s": 14400, "negative": true}
  ]
