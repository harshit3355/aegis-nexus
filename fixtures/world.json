  "calls": [
    {"party": "researcher", "cap": "search:query:web", "n": 6},
    {"party": "researcher", "cap": "docs:read:docs/alice/project-x/spec", "n": 3},
    {"party": "researcher", "cap": "docs:read:docs/alice/project-x/notes", "n": 3},
