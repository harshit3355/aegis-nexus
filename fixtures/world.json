    {"id": "S07", "family": "compromised tool", "title": "third-party search tool records every request", "capture": "search"},
    {"id": "S08", "family": "compromised tool", "title": "docs tool records every request", "capture": "docs"},
    {"id": "S09", "family": "compromised tool", "title": "repo tool records every request", "capture": "repo"},
    {"id": "S10", "family": "compromised tool", "title": "model gateway records every request", "capture": "model"},
    {"id": "S11", "family": "replay after revocation", "title": "researcher token stolen, task cancelled at 3 min", "steal": ["researcher"], "revoke": {"party": "researcher", "at_s": 180}},
    {"id": "S12", "family": "replay after revocation", "title": "linter token stolen, parent (coder) revoked at 2 min", "steal": ["linter"], "revoke": {"party": "coder", "at_s": 120}},
    {"id": "S13", "family": "replay after revocation", "title": "researcher token stolen, policy version retired at 5 min", "steal": ["researcher"], "retire_pv_at_s": 300},
    {"id": "S14", "family": "compromised sub-agent", "title": "researcher workload compromised, detected after 4 h", "compromise": "researcher", "detect_after_s": 14400},
    {"id": "S15", "family": "compromised sub-agent", "title": "coder workload compromised, detected after 4 h", "compromise": "coder", "detect_after_s": 14400},
    {"id": "S16", "family": "compromised sub-agent", "title": "linter workload compromised, detected after 4 h", "compromise": "linter", "detect_after_s": 14400},
    {"id": "S17", "family": "compromised sub-agent", "title": "researcher workload compromised, never detected", "compromise": "researcher"},
    {"id": "S18", "family": "confused deputy", "title": "prompt-injected researcher steered for 10 min (no exfiltration)", "steer": "researcher", "steer_s": 600},
    {"id": "S19", "family": "confused deputy", "title": "prompt-injected coder steered for 10 min (no exfiltration)", "steer": "coder", "steer_s": 600},
    {"id": "S20", "family": "over-broad delegation", "title": "linter key + token exfiltrated; attacker widens scope and extends lifetime", "exfil": ["linter"]},
